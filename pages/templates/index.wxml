<view class="page grouped" style="{{themeStyle}}">
  <view class="card">
    <view class="row tap" bindtap="openWizard" hover-class="pressed" hover-stay-time="80">
      <view class="row-main">
        <text class="row-title">{{planSummary ? '重新定制计划' : '定制训练计划'}}</text>
        <text class="meta">{{planSummary || '按场地、器材和每周时间排课'}}</text>
      </view>
      <view class="chev i i-chevron-right" />
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">还没有计划</view>

  <view wx:else class="card">
    <view class="row tap" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="edit" hover-class="pressed" hover-stay-time="80">
      <view class="row-main">
        <text class="row-title ellipsis">{{item.name}}</text>
        <text class="meta ellipsis num">{{item.sub}}</text>
      </view>
      <view class="chev i i-chevron-right" />
    </view>
  </view>

  <view class="dock-space"></view>
  <view class="dock">
    <view class="btn" bindtap="create" hover-class="pressed" hover-stay-time="80">新建计划</view>
  </view>
</view>
