page {
  background: var(--bg-group);
}

.top {
  padding: 32rpx 32rpx 8rpx;
}

.cur {
  display: flex;
  align-items: baseline;
}

.cur-num {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cur-unit {
  margin-left: 12rpx;
  color: var(--ink-2);
}

.range {
  margin-top: 32rpx;
}

.chart {
  display: block;
  width: 100%;
  height: 360rpx;
  margin: 16rpx 0 24rpx;
}

.chart-none {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.field-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--ink-2);
}

.field-date {
  display: flex;
  align-items: center;
}

/* 新记一条体重时淡入 */
.card .row {
  animation: fadeIn 0.22s ease both;
}
