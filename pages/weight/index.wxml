<view class="page grouped" style="{{themeStyle}}">
  <view class="card top">
    <view class="cur">
      <text class="cur-num num">{{overview.current || '–'}}</text>
      <text class="cur-unit">kg</text>
    </view>
    <text class="meta num">{{subText}}</text>

    <view class="tabs range">
      <text
        wx:for="{{ranges}}"
        wx:key="days"
        class="tab {{rangeDays === item.days ? 'on' : ''}}"
        data-d="{{item.days}}"
        bindtap="switchRange"
      >{{item.name}}</text>
    </view>

    <canvas wx:if="{{overview.points.length >= 2}}" type="2d" id="chart" class="chart"></canvas>
    <view wx:else class="chart-none">记满两次就会显示趋势线</view>
  </view>

  <view class="card">
    <view class="row tap" bindtap="openTarget" hover-class="pressed" hover-stay-time="80">
      <text class="row-main row-title">目标体重</text>
      <text class="row-val num">{{targetText}}</text>
      <view class="chev i i-chevron-right" />
    </view>
    <view wx:if="{{bmiText}}" class="row">
      <text class="row-main row-title">BMI</text>
      <text class="row-val num">{{bmiText}}</text>
    </view>
  </view>

  <block wx:if="{{logs.length > 0}}">
    <view class="label">记录</view>
    <view class="card">
      <view class="row tap" wx:for="{{logs}}" wx:key="id" data-id="{{item.id}}" bindtap="onLogTap" hover-class="pressed" hover-stay-time="80">
        <text class="row-main num">{{item.dateText}}</text>
        <text class="row-val num">{{item.weightKg}} kg</text>
      </view>
    </view>
  </block>

  <view class="dock-space"></view>
  <view class="dock">
    <view class="btn" bindtap="openAdd" hover-class="pressed" hover-stay-time="80">记录体重</view>
  </view>

  <!-- 记录体重 / 设置目标体重：共用内置数字键盘 -->
  <num-pad
    show="{{padOn}}"
    title="{{sheet === 'target' ? '目标体重' : '记录体重'}}"
    unit="kg"
    value="{{form.weightKg}}"
    min="{{25}}"
    max="{{250}}"
    decimals="{{1}}"
    allow-empty="{{sheet === 'target'}}"
    confirm-text="保存"
    bind:confirm="save"
    bind:close="closeSheet"
  >
    <picker slot="top" wx:if="{{sheet === 'log'}}" mode="date" value="{{form.date}}" end="{{todayStr}}" bindchange="onDate">
      <view class="input field tap-fx" hover-class="pressed" hover-stay-time="80">
        <text class="field-label">日期</text>
        <view class="field-date">
          <text class="num">{{form.date}}</text>
          <view class="chev i i-chevron-right" />
        </view>
      </view>
    </picker>
  </num-pad>
</view>
