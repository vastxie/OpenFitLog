<view class="page" style="{{themeStyle}}">
  <!-- 休息倒计时：从底部按钮后面升起，不挡标题和总计时 -->
  <view class="rest {{restLeft > 0 ? 'show' : ''}}">
    <view class="rest-info">
      <text class="rest-time num">{{restText}}</text>
      <text class="meta ellipsis">{{restLabel}}</text>
    </view>
    <view class="rest-act num tap-fx" bindtap="subRest" hover-class="pressed" hover-stay-time="80">−15</view>
    <view class="rest-act num tap-fx" bindtap="addRest" hover-class="pressed" hover-stay-time="80">+15</view>
    <view class="rest-act tap-fx" bindtap="skipRest" hover-class="pressed" hover-stay-time="80">跳过</view>
  </view>

  <view class="head">
    <input
      class="head-title"
      value="{{title}}"
      placeholder="训练名称"
      placeholder-class="ph"
      maxlength="30"
      bindinput="onTitleInput"
    />
    <view class="head-more tap-fx" bindtap="openMenu" hover-class="pressed" hover-stay-time="80">
      <view class="ic i i-more" />
    </view>
  </view>
  <view class="head-meta num">
    <text wx:if="{{live}}" class="head-clock">{{clock}}</text>
    <text>{{statText}}</text>
  </view>

  <view wx:if="{{exercises.length === 0}}" class="empty">还没有动作</view>

  <view class="ex" wx:for="{{exercises}}" wx:key="key" wx:for-index="i">
    <view class="ex-head">
      <view wx:if="{{item.posterUrl}}" class="ex-thumb tap-fx" data-id="{{item.exerciseId}}" bindtap="openDetail" hover-class="pressed" hover-stay-time="80">
        <image class="ex-img" src="{{item.posterUrl}}" mode="aspectFill" lazy-load />
      </view>
      <view class="ex-info tap-fx" data-id="{{item.exerciseId}}" bindtap="openDetail" hover-class="pressed" hover-stay-time="80">
        <text class="ex-name">{{item.name}}</text>
        <text wx:if="{{item.sub}}" class="meta">{{item.sub}}</text>
      </view>
      <view class="ex-more tap-fx" data-i="{{i}}" bindtap="openExMenu" hover-class="pressed" hover-stay-time="80">
        <view class="ic i i-more" />
      </view>
    </view>

    <text wx:if="{{item.hint}}" class="ex-hint">{{item.hint}}</text>
    <text wx:if="{{item.note}}" class="meta ex-tip">{{item.note}}</text>

    <view class="set-row set-head">
      <text class="c-idx">组</text>
      <text class="c-last">上次</text>
      <text wx:if="{{item.timed}}" class="c-wide">{{item.unitLabel}}</text>
      <block wx:else>
        <text class="c-in">kg</text>
        <text class="c-in">次</text>
      </block>
      <view class="c-chk"></view>
    </view>

    <view
      class="set-row {{st.done ? 'done' : ''}}"
      wx:for="{{item.sets}}"
      wx:for-item="st"
      wx:for-index="j"
      wx:key="index"
      data-i="{{i}}"
      data-j="{{j}}"
      bindlongpress="openSetMenu"
    >
      <!-- 长按这一行或点组号可以删除这一组 -->
      <text class="c-idx num" data-i="{{i}}" data-j="{{j}}" bindtap="openSetMenu">{{j + 1}}</text>
      <text class="c-last num">{{st.last}}</text>
      <view wx:if="{{item.timed}}" class="c-wide">
        <view class="set-input num tap-fx" data-i="{{i}}" data-j="{{j}}" data-f="val" bindtap="openPad" hover-class="pressed" hover-stay-time="80">{{st.val}}</view>
      </view>
      <block wx:else>
        <view class="c-in">
          <view class="set-input num tap-fx" data-i="{{i}}" data-j="{{j}}" data-f="weight" bindtap="openPad" hover-class="pressed" hover-stay-time="80">{{st.weight}}</view>
        </view>
        <view class="c-in">
          <view class="set-input num tap-fx" data-i="{{i}}" data-j="{{j}}" data-f="reps" bindtap="openPad" hover-class="pressed" hover-stay-time="80">{{st.reps}}</view>
        </view>
      </block>
      <view class="c-chk" data-i="{{i}}" data-j="{{j}}" bindtap="toggleDone">
        <view class="check set-check {{st.done ? 'done' : ''}}">
          <view wx:if="{{st.done}}" class="check-ic i i-check" />
        </view>
      </view>
    </view>

    <view class="add-set tap-fx" data-i="{{i}}" bindtap="addSet" hover-class="pressed" hover-stay-time="80">+ 加一组</view>

    <!-- 这个动作全部做完后，记一下感觉，下次据此调整重量 -->
    <view wx:if="{{item.allDone && !item.timed}}" class="rpe">
      <text class="meta">做完感觉</text>
      <view class="rpe-opts">
        <view class="opt rpe-opt {{item.rpe === 'easy' ? 'on' : ''}}" data-i="{{i}}" data-rpe="easy" bindtap="onPickRpe">轻松</view>
        <view class="opt rpe-opt {{item.rpe === 'good' ? 'on' : ''}}" data-i="{{i}}" data-rpe="good" bindtap="onPickRpe">合适</view>
        <view class="opt rpe-opt {{item.rpe === 'hard' ? 'on' : ''}}" data-i="{{i}}" data-rpe="hard" bindtap="onPickRpe">吃力</view>
      </view>
    </view>
  </view>

  <view class="dock-space {{restLeft > 0 ? 'with-rest' : ''}}"></view>
  <view class="dock">
    <view class="btn ghost" bindtap="openPicker" hover-class="pressed" hover-stay-time="80">添加动作</view>
    <view wx:if="{{live}}" class="btn" bindtap="finish" hover-class="pressed" hover-stay-time="80">结束训练</view>
  </view>

  <exercise-picker show="{{showPicker}}" bind:confirm="onPicked" bind:close="closePicker" />

  <num-pad
    show="{{pad.show}}"
    title="{{pad.title}}"
    unit="{{pad.unit}}"
    value="{{pad.value}}"
    min="{{pad.min}}"
    max="{{pad.max}}"
    decimals="{{pad.decimals}}"
    allow-empty="{{pad.allowEmpty}}"
    steps="{{pad.steps}}"
    step="{{pad.step}}"
    step-key="{{pad.stepKey}}"
    bind:confirm="onPadConfirm"
    bind:close="closePad"
  />

  <!-- 结束后的小结 -->
  <view class="sheet-mask" wx:if="{{showReport}}" catchtouchmove="noop">
    <view class="sheet report" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">训练完成</text>
      </view>
      <view class="rep-stats">
        <view class="rep-stat" wx:if="{{report.minutes > 0}}">
          <view><text class="rep-num num">{{report.minutes}}</text><text class="rep-unit">分钟</text></view>
          <text class="meta">时长</text>
        </view>
        <view class="rep-stat">
          <view><text class="rep-num num">{{report.doneSets}}</text><text class="rep-unit">组</text></view>
          <text class="meta">完成</text>
        </view>
        <view class="rep-stat" wx:if="{{report.volume > 0}}">
          <view><text class="rep-num num">{{report.volumeText}}</text><text class="rep-unit">kg</text></view>
          <text class="meta num">容量{{report.volumeDelta ? ' · 比上次 ' + report.volumeDelta : ''}}</text>
        </view>
      </view>
      <block wx:if="{{report.records.length > 0}}">
        <text class="sheet-label">新纪录</text>
        <view class="rep-rec" wx:for="{{report.records}}" wx:key="id">
          <text class="rep-rec-name ellipsis">{{item.name}}</text>
          <text class="rep-rec-val num">{{item.text}}</text>
          <text class="meta num rep-rec-before">之前 {{item.before}}</text>
        </view>
      </block>
      <view class="sheet-foot">
        <view class="btn" bindtap="closeReport" hover-class="pressed" hover-stay-time="80">完成</view>
      </view>
    </view>
  </view>

  <!-- 这个动作的休息时长 -->
  <view class="sheet-mask {{sheetOut ? 'out' : ''}}" wx:if="{{showRestSheet}}" catchtouchmove="noop" bindtap="closeRestSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title ellipsis">{{restEditName}}</text>
        <text class="sheet-action" bindtap="closeRestSheet">完成</text>
      </view>
      <text class="sheet-label">组间休息</text>
      <view class="opts-3">
        <view
          wx:for="{{smallRestOpts}}"
          wx:key="*this"
          class="opt num {{restEditSmall === item ? 'on' : ''}}"
          data-s="{{item}}"
          bindtap="pickSmallRest"
        >{{item}} 秒</view>
      </view>
      <text class="sheet-label rest-label-2">换动作休息</text>
      <view class="opts-3">
        <view
          wx:for="{{bigRestOpts}}"
          wx:key="*this"
          class="opt num {{restEditBig === item ? 'on' : ''}}"
          data-s="{{item}}"
          bindtap="pickBigRest"
        >{{item}} 秒</view>
      </view>
    </view>
  </view>
</view>
