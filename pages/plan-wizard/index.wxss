.top {
  padding-top: 16rpx;
  margin-bottom: 40rpx;
}

.track {
  height: 4rpx;
  background: var(--line);
}

.track {
  border-radius: 2rpx;
  overflow: hidden;
}

.track-fill {
  height: 100%;
  background: var(--ink);
  transition: width 0.36s var(--ease-out);
}

.top-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.skip {
  color: var(--ink-2);
  padding: 16rpx 0 16rpx 32rpx;
}

.q-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.q-sub {
  display: block;
  margin-top: 8rpx;
}

.sec-label {
  font-size: 24rpx;
  color: var(--ink-3);
  margin: 48rpx 0 16rpx;
}

.field {
  display: flex;
  align-items: center;
}

.field-in {
  flex: 1;
  height: 100%;
  font-size: 32rpx;
}

.field-unit {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

/* 单选列表：普通列表行 + 右侧圆形勾选 */
.choices {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.choice {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.choice .check {
  margin-left: 24rpx;
}

.choice.stretch {
  margin-top: 48rpx;
  border-top: 1rpx solid var(--line);
}

.days {
  margin-top: 40rpx;
}

/* 第 1、2 步的数字项：列表行，点开弹面板输入 */
.fields {
  margin-top: 48rpx;
}

.fields .row {
  min-height: 112rpx;
}

.fields .row-val {
  color: var(--ink);
}

.fields .row-val.faint {
  color: var(--ink-3);
}

/* 生成中 */
.gen {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
}

.gen-pct {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
}

.gen-title {
  margin-top: 8rpx;
  color: var(--ink-2);
}

.gen-stages {
  margin-top: 64rpx;
}

.gen-stage {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  color: var(--ink-3);
  transition: color 0.24s ease;
}

.gen-stage.doing,
.gen-stage.done {
  color: var(--ink);
}

.gen-check {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  border-width: 2rpx;
}

/* 结果 */
.res-title {
  padding-top: 32rpx;
}

.res {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.res-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.res-name {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 每个动作：部位图标 + 名称 + 组数 */
.res-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.res-part {
  width: 36px;
  height: 36px;
  margin-right: 20rpx;
}

.res-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.res-item-name {
  font-size: 28rpx;
}


/* 换题时新内容淡入上移；生成中、结果页同样淡入 */
.q-title,
.q-sub,
.sec-label,
.choices,
.opts-2,
.opts-3,
.opts-4,
.days,
.choice.stretch,
.gen,
.res {
  animation: fadeUp 0.3s var(--ease-out) both;
}
