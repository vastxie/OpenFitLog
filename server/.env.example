# 监听地址与端口（生产环境建议反代 Nginx / Caddy 开启 HTTPS）
HOST=127.0.0.1
PORT=8787

# 必填（生产环境）：用于签发 Bearer Token 的随机密钥（建议 openssl rand -hex 32 生成）
TOKEN_SECRET=replace-with-at-least-32-random-characters

# 必填（生产环境）：微信小程序 AppID 与 AppSecret（用于 wx.login code 换取 openid）
WX_APP_ID=
WX_APP_SECRET=

# 数据存储目录（默认 server/data）
DATA_DIR=./server/data

# 仅限本地开发调试（例如微信开发者工具 touristappid 游客模式）：
# 设置后无需 WX_APP_ID / WX_APP_SECRET，所有登录固定映射到该虚拟 openid。生产环境严禁开启！
DEV_MOCK_OPENID=
