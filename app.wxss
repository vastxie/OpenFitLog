/*
 * 全局样式
 * 颜色：三档墨色 + 细分割线，全部走变量，深色模式只换变量的值
 * --primary 跟随主题，用在主按钮和选中态；--accent 只表示「已完成」
 * 字号：24 / 28 / 32 / 40 / 64   字重：400 / 600
 * 圆角：卡片和面板 32rpx，按钮 / 输入 / 选项 / 海报 24rpx，缩略图和日历格 20rpx，其余圆形
 * 动效：出现用 --ease-out，按下立即变淡、松开 0.2s 恢复；只给状态变化加动效，不做装饰动画
 * 列表和概览页（.page.grouped）用浅灰底 + 无阴影白卡片；操作页白底，不用卡片
 */
page {
  --bg: #ffffff;
  --bg-group: #f4f4f4;
  --card: #ffffff;
  --ink: #111111;
  --ink-2: #666666;
  --ink-3: #a3a3a3;
  --ink-4: #c8c8c8;
  --line: #ebebeb;
  --fill: #f5f5f5;
  --seg-on: #ffffff;
  --mask: rgba(0, 0, 0, 0.4);
  --on-heat: #ffffff;

  --r-card: 32rpx;
  --r-ctl: 24rpx;
  --r-sm: 20rpx;
  --ease-out: cubic-bezier(0.32, 0.72, 0, 1);
  --ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* 各主题的主色 / 主色上的文字 / 完成色。页面用 getThemeStyle() 选其中一组 */
  --p-ink: #111111;
  --op-ink: #ffffff;
  --a-ink: #16a365;
  --p-emerald: #16a365;
  --op-emerald: #ffffff;
  --a-emerald: #16a365;
  --p-blue: #2563eb;
  --op-blue: #ffffff;
  --a-blue: #2563eb;
  --p-violet: #7c3aed;
  --op-violet: #ffffff;
  --a-violet: #7c3aed;
  --p-orange: #ea580c;
  --op-orange: #ffffff;
  --a-orange: #ea580c;
  --p-rose: #e0457b;
  --op-rose: #ffffff;
  --a-rose: #e0457b;
  --p-mauve: #b85c72;
  --op-mauve: #ffffff;
  --a-mauve: #b85c72;

  --primary: var(--p-ink);
  --on-primary: var(--op-ink);
  --accent: var(--a-ink);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 深色模式：主色提亮一档，墨黑主题反转成白色按钮 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #111111;
    --bg-group: #111111;
    --card: #1c1c1c;
    --ink: #ededed;
    --ink-2: #9b9b9b;
    --ink-3: #6b6b6b;
    --ink-4: #4d4d4d;
    --line: #2c2c2c;
    --fill: #2a2a2a;
    --seg-on: #4a4a4a;
    --mask: rgba(0, 0, 0, 0.6);
    --on-heat: #111111;

    --p-ink: #ededed;
    --op-ink: #111111;
    --a-ink: #22b573;
    --p-emerald: #22b573;
    --a-emerald: #22b573;
    --p-blue: #3b82f6;
    --a-blue: #3b82f6;
    --p-violet: #8b5cf6;
    --a-violet: #8b5cf6;
    --p-orange: #f97316;
    --a-orange: #f97316;
    --p-rose: #ec5f8f;
    --a-rose: #ec5f8f;
    --p-mauve: #c97287;
    --a-mauve: #c97287;
  }
}

view,
text,
scroll-view,
input,
button,
image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx;
}

/* 分组卡片：只在 .page.grouped 页面用，无阴影 */
.card {
  margin-top: 24rpx;
  padding: 0 32rpx;
  border-radius: var(--r-card);
  background: var(--card);
}

.card > .row:last-child {
  border-bottom: none;
}

.grouped .label {
  padding: 32rpx 32rpx 0;
}

.label + .card {
  margin-top: 16rpx;
}

.num {
  font-variant-numeric: tabular-nums;
}

.meta {
  font-size: 24rpx;
  color: var(--ink-2);
}

.faint {
  color: var(--ink-3);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分组小标题 */
.label {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 48rpx 0 8rpx;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* 按压反馈：wxml 上用 hover-class="pressed"；松开时按下面的 transition 淡回 */
.row.tap,
.btn,
.tap-fx {
  transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
}

.pressed {
  opacity: 0.5 !important;
  transition-duration: 0s !important;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-title {
  font-size: 32rpx;
}

.row-val {
  flex-shrink: 0;
  color: var(--ink-2);
  margin-left: 24rpx;
}

.chev {
  display: block;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.ic {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* 按钮 */
.btn {
  flex: 1;
  height: 96rpx;
  border-radius: var(--r-ctl);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.ghost {
  background: var(--fill);
  color: var(--ink);
}

.btn.disabled {
  background: var(--fill);
  color: var(--ink-3);
}

.btn.narrow {
  flex: 0 0 216rpx;
}


/* 底部固定操作栏 */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.dock-space {
  height: calc(164rpx + env(safe-area-inset-bottom));
}

/* Tab 页底部已有 tabBar 垫着安全区 */
.dock.in-tab {
  padding-bottom: 16rpx;
}

.sheet.in-tab {
  padding-bottom: 24rpx;
}

.dock-space.in-tab {
  height: 164rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--ink-3);
}

/* 输入框 */
.input {
  height: 96rpx;
  background: var(--fill);
  border-radius: var(--r-ctl);
  padding: 0 24rpx;
  font-size: 32rpx;
}

.ph {
  color: var(--ink-3);
}

/* 可选项：未选灰底，选中主色。休息时长、星期、性别等都用它 */
.opt {
  height: 88rpx;
  border-radius: var(--r-ctl);
  background: var(--fill);
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.18s ease, color 0.18s ease;
}

.opt.on {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

.opts-2,
.opts-3,
.opts-4 {
  display: grid;
  gap: 16rpx;
}

.opts-2 {
  grid-template-columns: repeat(2, 1fr);
}

.opts-3 {
  grid-template-columns: repeat(3, 1fr);
}

.opts-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 圆形勾选：默认空心，on 为主色，done 为完成色 */
.check {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid var(--ink-4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.check.on {
  background: var(--primary);
  border-color: var(--primary);
}

.check.done {
  background: var(--accent);
  border-color: var(--accent);
}

.check-ic {
  width: 60%;
  height: 60%;
  animation: pop 0.28s var(--ease-pop) both;
}

.check.done .check-ic {
  background-color: #ffffff;
}

/* 文字切换（周 / 月 / 年） */
.tabs {
  display: flex;
  gap: 48rpx;
}

.tab {
  position: relative;
  font-size: 32rpx;
  color: var(--ink-3);
  padding: 16rpx 0;
  transition: color 0.2s ease;
}

.tab.on {
  color: var(--ink);
  font-weight: 600;
}

.tab.on::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--ink);
  animation: tabLine 0.26s var(--ease-out) both;
}

/* 部位图标：人体剪影（25%）+ 目标肌肉实心，单色。尺寸用整数 px，不随 rpx 缩放出小数（图标见 tools/build-part-icons.js，对应规则见 config.getPartIcon） */
.part {
  flex-shrink: 0;
}

.part-ic {
  width: 100%;
  height: 100%;
  background-color: var(--ink-2);
  transition: background-color 0.2s ease;
}

/* 通用动效 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pop {
  from { opacity: 0; transform: scale(0.4); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes tabLine {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* 底部弹出面板：打开上滑，关闭时 .out 下滑（utils/ui.js 的 closeSheet 负责等动画播完再移除） */
@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes maskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes sheetSlideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: var(--mask);
  display: flex;
  align-items: flex-end;
  animation: maskFadeIn 0.24s ease-out both;
}

.sheet-mask.out {
  pointer-events: none;
  animation: maskFadeOut 0.2s ease-in both;
}

.sheet-mask.out .sheet {
  animation: sheetSlideDown 0.2s cubic-bezier(0.4, 0, 1, 1) both;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: var(--r-card) var(--r-card) 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: sheetSlideUp 0.32s var(--ease-out) both;
}

.sheet-head {
  flex-shrink: 0;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-action {
  color: var(--ink-2);
  padding: 16rpx 0 16rpx 32rpx;
}

.sheet-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin: 8rpx 0 16rpx;
}

.sheet-foot {
  display: flex;
  gap: 16rpx;
  padding-top: 32rpx;
}

/* 页面底部的次要操作（删除等） */
.foot-link {
  padding: 64rpx 0 32rpx;
  text-align: center;
  color: var(--ink-2);
}

/* ICONS:START 由 tools/build-icons.js 生成，不要手改 */
.i {
  display: block;
  flex-shrink: 0;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

